{
  "source_language": "auto",
  "target_language": "Russian",
  "target_language_code": "russian",
  "provider": {
    "type": "ollama",
    "base_url": "http://127.0.0.1:11434",
    "endpoint": "/api/chat",
    "model": "qwen2.5:14b",
    "timeout_seconds": 180,
    "temperature": 0.2,
    "max_retries": 2,
    "retry_delay_seconds": 2
  },
  "batch": {
    "max_segments": 6,
    "max_chars": 6000
  },
  "context": {
    "previous": 2,
    "next": 2
  },
  "translation": {
    "use_existing_translation_memory": true,
    "include_statuses": [
      "pending",
      "error"
    ],
    "channels": [
      "semantic"
    ]
  },
  "glossary": {},
  "notes": "",
  "validation": {
    "reject_empty": true,
    "max_length_ratio": 6.0,
    "min_source_chars_for_ratio": 20
  }
}
